# Secrets — set on the host. Never commit a real .env.
TELEGRAM_TOKEN=
LINKTAIN_API_KEY=

# Comma-separated Telegram user IDs allowed to create links and run /stats.
# Leaving this BLANK overrides the built-in default and lets anyone who can
# message the bot spend your Linktain API key.
ADMIN_USER_IDS=7739393155

# /start buttons
TUTORIAL_URL=https://t.me/linktaintutorail
VIP_URL=https://buy.stripe.com/28E5kE0hGc7n4a14Hn5AQ01
DISCORD_URL=https://discord.gg/bgnQtMeucK
# Fallback used only when TUTORIAL_URL is empty. Produces a t.me/c/… link,
# which opens for existing members of that chat only.
TUTORIAL_CHAT_ID=-1003495156964

LINKTAIN_API_URL=https://linktain.com/api/v1
API_TIMEOUT=20000
COOLDOWN_MS=5000
PORT=3000

# Optional. Overrides the /start message body.
WELCOME_TEXT=
